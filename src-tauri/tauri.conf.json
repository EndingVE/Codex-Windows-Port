{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexBar",
  "version": "0.1.0",
  "identifier": "com.codexbar.win",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "CodexBar",
        "width": 420,
        "height": 720,
        "minWidth": 380,
        "minHeight": 420,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#0d0f13",
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
